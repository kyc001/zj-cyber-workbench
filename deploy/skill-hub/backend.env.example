# Copy to /etc/zj-skill-hub/backend.env and replace every CHANGE_ME value.
SKILL_HUB_DATABASE_URL=mysql+aiomysql://zj_skillhub:CHANGE_ME@127.0.0.1:3306/zj_skill_hub?charset=utf8mb4
SKILL_HUB_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/11
SKILL_HUB_STORAGE_DIR=/var/lib/zj-skill-hub/packages
SKILL_HUB_JWT_SECRET=CHANGE_ME
SKILL_HUB_ACCESS_TOKEN_MINUTES=1440
SKILL_HUB_BIND_HOST=0.0.0.0
SKILL_HUB_BIND_PORT=8011
SKILL_HUB_CORS_ORIGINS=http://CHANGE_ME:3011
